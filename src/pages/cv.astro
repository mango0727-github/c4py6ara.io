---
import { site } from '@config/site';
import Page from '@layouts/Page.astro';
import { withBase } from '@utils/base';
import { Icon } from 'astro-icon/components';

const pdfHref = withBase(site.cv.pdfPath);
---

<Page title="CV" description={`Curriculum vitae of ${site.author.name}`}>
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">
        cv
        <a
          href={pdfHref}
          target="_blank"
          rel="noopener noreferrer"
          class="float-right"
          aria-label="Download CV PDF"
        >
          <Icon name="fa-solid:file-pdf" />
        </a>
      </h1>
    </header>

    <article>
      <p class="cv-actions">
        <a class="cv-open-btn" href={pdfHref} target="_blank" rel="noopener noreferrer">
          <Icon name="fa-solid:file-pdf" /> Open the CV (PDF)
        </a>
      </p>
      <!-- Mobile browsers cannot display PDFs inline; the embed is hidden there
           and the button above is the primary way to open the CV. -->
      <object class="cv-embed" data={pdfHref} type="application/pdf" aria-label="CV PDF">
        <p class="cv-fallback">
          Your browser cannot display PDFs inline.
          <a href={pdfHref} target="_blank" rel="noopener noreferrer">Open the CV (PDF)</a> instead.
        </p>
      </object>
    </article>
  </div>
</Page>

<style>
  .post-title {
    font-family: var(--font-sans);
    color: var(--global-text-color);
  }

  .post-title a {
    color: var(--global-theme-color);
    font-size: 0.75em;
  }

  .cv-embed {
    display: block;
    /* 1.5x the content-column width, centered, capped at the viewport */
    width: min(150%, calc(100vw - 2rem));
    margin-block: 1rem 2rem;
    margin-inline: calc((100% - min(150%, calc(100vw - 2rem))) / 2);
    height: 90vh;
    min-height: 600px;
    border: 1px solid var(--global-divider-color);
    border-radius: 0.375rem;
  }

  .cv-fallback {
    padding: 2rem 1rem;
    text-align: center;
    color: var(--global-text-color);
  }

  .cv-fallback a {
    color: var(--global-theme-color);
  }

  .cv-actions {
    margin: 1.5rem 0 0;
  }

  .cv-open-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--global-theme-color);
    border-radius: 0.375rem;
    color: var(--global-theme-color);
    font-weight: 500;
    text-decoration: none;
  }

  .cv-open-btn:hover {
    background: var(--global-theme-color);
    color: var(--global-hover-text-color, #fff);
  }

  @media (max-width: 768px) {
    .cv-embed {
      display: none;
    }
  }
</style>
